# Environment variables for Celo MiniApp deployment
# Copy this file to .env and fill in your values

# Your private key (without 0x prefix) - KEEP THIS SECRET
PRIVATE_KEY=your_private_key_here

# Celo Forno RPC (default public endpoint)
CELO_FORNO_RPC=https://forno.celo.org

# Alfajores testnet RPC (for testing)
ALF_RPC=https://alfajores-forno.celo-testnet.org

# Optional: Alchemy/Infura API key if using their RPC
# ALCHEMY_API_KEY=your_alchemy_key_here
